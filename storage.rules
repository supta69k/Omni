rules_version = '2';

// Omni — Cloud Storage security rules (BACKEND_PLAN §8).
//
// Publish with:  firebase deploy --only storage
//
// Avatars and post images are world-readable because they are rendered by URL; certificates are not,
// because they are someone's professional credentials. Every write is capped and content-type checked,
// which is what stops the bucket being used as free file hosting.

service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /posts/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /certificates/{uid}/{file} {
      allow read:  if request.auth != null
                   && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
