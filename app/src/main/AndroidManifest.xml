<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase Auth, Firestore and Storage all need the network; the manifest previously declared
         no permissions at all, so every call would have failed at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The step counter. A runtime permission from API 29 up; below that the declaration alone is
         enough. Refusing it is handled in the UI (the card offers to turn tracking on) rather than
         being treated as an error. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The SOS screen's hospital sort (Phase 9). Runtime permissions; the screen degrades to the
         unsorted directory when they are refused rather than blocking the emergency flow on them. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- MapLibre's connectivity receiver reads this to know when tiles can be fetched again. Without
         it the map keeps retrying dead requests instead of resuming cleanly when the network returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 10. Runtime-requested on API 33+ only; below that a notification needs no permission at
         all. Refusing it leaves the in-app inbox and the bell badge working — nothing is gated on it,
         the user simply stops getting tray entries. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The tracking service's persistent panel (steps + water). A foreground service needs the base
         permission, and on API 34+ the health type must also be declared and backed by a health
         permission — ACTIVITY_RECOGNITION above — before the service may start. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Restarting the tracking service after a reboot or an app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Not required: plenty of devices have no pedometer, and the app is perfectly usable without
         one. Marking it required would hide Omni from those devices in the Play Store. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application
        android:name=".OmniApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omni">
        <!-- The app handles rotation itself rather than being recreated on it. This is NOT a portrait
             lock — the window still rotates; the Activity simply stays alive, so DesignFrame re-measures
             through BoxWithConstraints and all in-memory UI state (scroll positions, the onboarding
             pager page, open sheets, half-typed drafts) survives the turn instead of resetting to
             Splash. rememberSaveable on the router state (MainActivity) covers the separate case of a
             low-memory process kill, which configChanges cannot. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Omni"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 10. `exported="false"`: only the Play Services messaging component binds to this,
             and it does so from within the same app's process boundary. -->
        <service
            android:name=".service.OmniMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The live tracking foreground service: one sensor listener and one reconciler per process,
             alive while Omni is closed, with today's steps and water as its persistent panel. The
             health type is what lets it run long-term on API 34+; ACTIVITY_RECOGNITION above is the
             health permission that backs it. -->
        <service
            android:name=".service.OmniTrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Restarts the tracking service after a reboot or an app update. MIUI additionally gates
             this behind the app's Autostart toggle. -->
        <receiver
            android:name=".service.OmniBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The icon and channel Android falls back to when a push arrives while the app is in the
             background and the payload names neither. Without the channel id, a message delivered on
             API 26+ before any screen has run would be dropped silently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_bell" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="omni_general" />

        <!-- Shares the generated health-report PDF out of cache without granting the whole app's
             files. `grantUriPermissions` is what lets the share intent hand a read-only URI to
             another app without the report ever touching shared storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>