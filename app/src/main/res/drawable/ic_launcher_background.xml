<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon's back layer.

    White, because that is what the app is: the splash screen this icon opens into is the same torus on
    the same white field, so the tap and the first frame are one continuous image rather than two
    unrelated pictures. Every mask shape a launcher can apply — circle, squircle, rounded square — gets
    the same flat fill, so the mark never lands half on a seam.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/omni_launcher_background" />
</shape>
