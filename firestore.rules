rules_version = '2';

// Omni — Firestore security rules (BACKEND_PLAN §8).
//
// Publish with:  firebase deploy --only firestore:rules
//
// The whole file is deny-by-default: a path with no `match` block is unreachable, so a new collection
// is locked until a rule is written for it deliberately. Two deviations from BACKEND_PLAN §8 are
// marked inline below; both close holes rather than open them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function isSelf(uid)  { return signedIn() && request.auth.uid == uid; }
    function isAdmin()    { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      // Every signed-in user can read every profile, because the feed, the story strip, the profile
      // page and the "new chat" picker all need somebody else's name, photo and `verified` flag.
      //
      // **Known cost, recorded rather than hidden (Phase 13):** rules cannot hide individual fields, so
      // this also exposes `email`, `prefs` and `fcmTokens` to any signed-in account. Neither of the
      // last two is exploitable on its own — a token is useless without the server key — but the email
      // is real exposure. Closing it properly means splitting the document in two (a public
      // `name`/`photoUrl`/`verified` half and a private half), which is a data migration, not a rule.
      // It is the right fix; it is not a Phase 13 fix.
      allow read: if signedIn();

      // DEVIATION 1 from §8, which allowed any self-create. Without these guards the very first
      // write of a hand-rolled client could set `role: 'ADMIN'` or `verified: true` — the update rule
      // below blocks changing those keys, but nothing was stopping them being born that way.
      // FirebaseAuthRepository.writeNewUser sends exactly name/email/role/verified/createdAt, so it
      // satisfies this as written.
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'USER'
                    && request.resource.data.verified == false
                    && !request.resource.data.keys().hasAny(['profession', 'unread']);

      // A user may never grant themselves role, verification or unread counts.
      allow update: if isSelf(uid)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['role','verified','profession','unread']);
      allow update: if isAdmin();
      allow delete: if false;

      match /days/{day}           { allow read, write: if isSelf(uid); }
      match /days/{day}/meals/{m} { allow read, write: if isSelf(uid); }
      match /sleep/{date}         { allow read, write: if isSelf(uid); }
      match /guideProgress/{g}    { allow read, write: if isSelf(uid); }
      match /emergencyContacts/{c}{ allow read, write: if isSelf(uid); }
      match /following/{target}   { allow read: if signedIn(); allow write: if isSelf(uid); }

      // The mirror of the line above, and the only reason it exists: a follower *count* cannot be
      // derived from `following` alone. "Who follows me" would be a query across every user's
      // `following` subcollection, and the aggregation that answers it cheaply has to run over one
      // collection — so the follow writes both halves in a batch.
      //
      // The document id is the follower's own uid, so `isSelf(follower)` lets a user add or remove
      // only themselves from anybody's list. Nobody can insert a third party, and nobody can inflate
      // a count: one follower is one document that only that follower can create.
      match /followers/{follower} { allow read: if signedIn(); allow write: if isSelf(follower); }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.repostCount == 0
                    && request.resource.data.body.size() <= 2000;

      // DEVIATION 2 from §8, which also allowed any signed-in user to write likeCount /
      // commentCount / repostCount directly so the client could `increment` them. Rules cannot check
      // "+1, and a matching like document exists", so that rule let anyone set a post's like count to
      // any number. §12 recommends the Cloud Function instead, so the client is simply not allowed to
      // touch the counters: the trigger runs with admin credentials and bypasses rules entirely.
      // If you ever decide to go back to client increments, this is the one line to add.
      //
      // **`authorId` is immutable.** The clause below matches on `resource.data.authorId` — the value
      // already stored — so without the second line an author could edit their own post and hand it to
      // somebody else's uid, and it would appear under that person's name, on their profile, with
      // their badge. Nothing in the app writes `authorId` on an update, so requiring it to be unchanged
      // costs the client nothing. Phase 13.
      allow update: if signedIn()
                    && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.body.size() <= 2000;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }

      // A repost, as one marker document whose id is the reposter's uid — the same shape as a like,
      // for the same reason: the document's existence *is* the fact, so it cannot be double-counted
      // and a second tap writes the same id rather than a second row. `isSelf(uid)` is what makes
      // the count honest: one person can create exactly one of these, under their own name, and
      // nobody can mark a repost on somebody else's behalf.
      //
      // The quoting post that goes with it is an ordinary `posts` create, covered above and subject
      // to the same `authorId == request.auth.uid`. The client writes both in one batch, so a marker
      // whose post was refused cannot exist.
      match /reposts/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        // The 500 is headroom over the composer's own 280-character cap, not a second opinion about
        // it: the point is that a hand-rolled client cannot put a megabyte of text on someone else's
        // post, in a collection every reader of that post downloads. Phase 13.
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.body.size() <= 500;
        allow update: if signedIn()
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId == resource.data.authorId
                      && request.resource.data.body.size() <= 500;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /verificationRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // The applicant submits; only an admin may set status.
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';

      // Re-applying after a rejection. `create` covers the first application only — the document
      // survives the decision, so a second attempt is an *update* over the same id. It is allowed
      // out of `rejected` and back to `pending` and from nowhere else: a pending application cannot
      // be edited out from under the reviewer reading it, and an approved one cannot be reopened by
      // the account that benefits from it. The admin clause stays first-class — a reviewer's own
      // update is what sets any status other than these two.
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && resource.data.status == 'rejected'
                        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /notifications/{uid}/items/{id} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // DEVIATION 3 from §8, which reserved every create for the Cloud Functions. A user may now write
      // into their *own* inbox and nobody else's, which is what lets Phase 10 ship something real
      // before Phase 12's functions exist: the SOS screen records "your alert was saved" the moment it
      // writes the event. The blast radius is a user filling their own list — the cross-account writes
      // (a like, a comment, a follow) still cannot be forged, because `isSelf(uid)` is the recipient.
      allow create: if isSelf(uid);
      allow delete: if false;                  // Cloud Functions only (they bypass rules)
    }

    match /conversations/{cid} {
      function participantOf(convoId) {
        return signedIn()
               && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId))
                    .data.participants;
      }

      allow read:   if signedIn() && request.auth.uid in resource.data.participants;

      // Two participants, and two *different* ones. `size() == 2` alone is satisfied by
      // `[uid, uid]` — a thread with one person in it twice, which the client can produce by
      // handing its own uid to both sides of `conversationIdOf`. Nothing renders it (the list
      // cannot name an "other" side that is not there) and nothing could ever arrive in it, so it
      // is a document that exists only to be wrong. The client guards this too; this is the half
      // that also holds for a client nobody wrote. Phase 13.
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0] != request.resource.data.participants[1];

      // The pair is fixed at creation. Without the second line either participant could rewrite
      // `participants` — dropping the other person out of a thread they can no longer read, or adding
      // a third party to one they were never in. Phase 13.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{mid} {
        allow read: if participantOf(cid);

        // **Being the sender is not enough.** The read rule has always checked participation; create
        // only checked that `senderId` was the caller's own uid, so any signed-in user could write a
        // message into any conversation id — a stranger's thread, with a name attached — and simply
        // not be able to read the reply. The client derives the id from the two uids
        // (`conversationIdOf`) and is always a participant, so this costs it nothing. Phase 13.
        allow create: if participantOf(cid)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /sosEvents/{uid}/items/{id} {
      allow read, write: if isSelf(uid);
      allow read: if isAdmin();
    }

    // OTP rate limits — backend-only, clients must not access
    match /otp_rate_limits/{uid} {
      allow read, write: if false;
    }
    match /otp_verify_rate_limits/{uid} {
      allow read, write: if false;
    }
    // OTP codes — backend-only, clients must not access
    match /otp_codes/{uid} {
      allow read, write: if false;
    }

    // The public hospital directory (BACKEND_PLAN §7). Read-only for every signed-in client; the
    // documents are written from the console or an import script, never from the app — which is
    // what makes the directory available offline through Firestore's cache after the first sync.
    match /hospitals/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The pharmacy directory — the hospitals directory's twin: same schema, same seeder
    // (`tools/seed-hospitals.mjs --collection pharmacies`), same read-only contract. Without a
    // match here the collection is denied by default and the app's listener silently degrades to
    // an empty pharmacy layer, which is the one failure a directory must not be allowed to hide.
    match /pharmacies/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The Omni+ doctor directory — the hospitals directory's sibling: verified doctors written
    // from the console or an import script, never from the app. Read-only for signed-in clients,
    // which keeps the directory available offline through Firestore's cache after the first sync.
    match /doctors/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Stories (§7's social surface): a 24-hour image with optional text. Any signed-in user reads
    // the strip; only the author creates or deletes, and the create must carry their own uid.
    // `update` is closed deliberately — a story is published once and taken down, never edited.
    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
