local.properties

# Firebase config — contains the project API key; each dev downloads their own.
google-services.json

# The seed script's service-account key — full database access, never commit it.
tools/service-account.json
tools/node_modules/
tools/package-lock.json

# Firebase emulator leavings (the rules tests). The logs hold every request the emulator answered;
# .firebase/ is the CLI's local cache, including rule-coverage reports.
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log
firebase-debug.*.log
.firebase/

# Figma MCP personal access token — loaded by figma-developer-mcp via --env, never commit it.
.figma.env

# Release signing — never commit the keystore or its passwords
omni-release.jks
*.jks
*.keystore
keystore.properties

# Firebase Cloud Functions build output + deps (only src is committed)
functions/node_modules/
functions/lib/

# Local scratch from debugging sessions
.tmp-*
figma-177-17*
