# Firebase Admin SDK credentials
# Get this from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the entire JSON as a single line here
FIREBASE_SERVICE_ACCOUNT=

# SendGrid API Key
# Get this from SendGrid Settings > API Keys
SENDGRID_API_KEY=

# Sender email (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Server port (default: 3000)
PORT=3000

# Firebase Hosting URL for email verification links
# Use your Firebase project's hosting URL or custom domain
FIREBASE_HOSTING_URL=https://omni-2c987.firebaseapp.com

# Gemini API key for AI meal analysis (Phase 7)
# Get a FREE-tier key from Google AI Studio (https://aistudio.google.com/apikey).
# This key lives ONLY here on the server — never put it in the Android app or commit the real value.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to a free-tier Flash-Lite model)
# GEMINI_MODEL=gemini-2.5-flash-lite